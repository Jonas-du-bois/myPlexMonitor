# ─────────────────────────────────────────────────────────────────────────────
# MyPlexMonitor - Hybrid HA config (LOCAL + BACKUP)
# ─────────────────────────────────────────────────────────────────────────────

# LOCAL (Ubuntu master) or BACKUP (Render sentinel)
ROLE=LOCAL

# Telegram bot
TELEGRAM_TOKEN=your_telegram_bot_token
# Un ou plusieurs chat IDs autorisés (séparés par des virgules)
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Plex target
# LOCAL: monitor.js checks 127.0.0.1 automatically
# BACKUP: set your public IP or DDNS name
PLEX_IP=127.0.0.1
PLEX_PORT=32400
CHECK_INTERVAL=30000

# Web server for keep-alive / healthcheck
PORT=3000

# qBittorrent WebUI
QBITTORRENT_HOST=127.0.0.1
QBITTORRENT_PORT=8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=

# AI Renaming
GEMINI_API_KEY=

# Download paths
MOVIES_PATH=/mnt/films
SERIES_PATH=/mnt/films/series
OTHER_PATH=/mnt/films/downloads

# qBittorrent categories
QBITTORRENT_CATEGORY_MOVIE=movies
QBITTORRENT_CATEGORY_SERIES=series
QBITTORRENT_CATEGORY_OTHER=other
